# Copy to .env and adjust. All values have sensible local defaults except ADMIN_TOKEN.
ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/readly?sslmode=disable
# Shared secret the admin app sends as "Authorization: Bearer <token>".
# Temporary until admin accounts are added with user login.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Browser origins allowed to call the API directly (reader, admin).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_EPUB_MB=100
MAX_IMAGE_MB=10
