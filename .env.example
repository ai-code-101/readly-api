# Copy to .env and adjust. All values have sensible local defaults except ADMIN_TOKEN.
ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/readly?sslmode=disable
# Shared secret the admin app sends as "Authorization: Bearer <token>".
# Temporary until admin accounts are added with user login.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Browser origins allowed to call the API directly (reader, admin).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
MAX_EPUB_MB=100
MAX_IMAGE_MB=10

# --- Phone OTP / subscriptions ---------------------------------------------
# "log" prints OTP codes in this terminal (development); "live" sends them by SMS.
SMS_MODE=log
SMS_API_URL=https://messaging-peak-1048592730476.europe-west4.run.app/api/v1/message/100/user/send
SMS_CHANNEL=SENDERNAME
SMS_ORG_ID=
# Optional bearer token for the messaging API.
SMS_API_TOKEN=
# Random 32+ character secret used to hash OTP codes. Required in live mode.
OTP_SECRET=
# Each successful subscription grants this many hours (daily plan, KES 10 airtime).
SUBSCRIPTION_HOURS=24
SUBSCRIPTION_PRICE_KES=10
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
